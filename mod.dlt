# ============================
#  Dolet Text Library
# ============================
# Script-aware text processing: Arabic shaping today, bidirectional ordering
# alongside it. Pure Dolet on top of the unicode package, so it cross-compiles
# anywhere and every rule in it is testable without a font or a window.
module text
import unicode

load text/shape
load text/bidi

export SHAPE_ISOLATED
export SHAPE_FINAL
export SHAPE_INITIAL
export SHAPE_MEDIAL
export arabic_forms
export arabic_form_of
export arabic_lam_alef
export arabic_shape
export arabic_shape_str
export arabic_shape_mapped
export bidi_paragraph_level
export bidi_resolve
export bidi_reorder
export bidi_visual_order
export text_display_order
export text_display_str
export text_display_into
export text_display_detail
export text_display_str_into
export text_display_scratch_slots
export text_needs_display_pass
